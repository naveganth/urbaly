# Copy to `.env` and fill in. See `frontend/lib/env.ts` for precedence:
# platform env > `frontend/.env*` > repo-root `.env*`.
# Production must set these in the hosting platform's env manager.

# Backend (server-only, never exposed to the browser)
API_BASE_URL=http://localhost:8080/v1/db
AUTH_BASE_URL=http://localhost:8080/v1/auth

# Exposed to the browser via `/api/public-config` only (public by design;
# protect with provider-side restrictions: CARTO referrer allowlist,
# Google authorized origins).
# The map boots on keyless OpenFreeMap; CARTO_API_KEY is fallback-only
# (used only when OpenFreeMap is unreachable) and may be left unset.
CARTO_API_KEY=
GOOGLE_CLIENT_ID=
