# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Single source of truth for the repo (frontend/ lives in a subdir).

# dependencies
node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (templates are committed)
.env*
!.env.example
frontend/.env*
!frontend/.env.example

# MapLibre worker bundle (generated by postinstall: frontend/scripts/copy-maplibre-worker.mjs)
frontend/public/maplibre/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
